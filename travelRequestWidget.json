{
  "id": "com.company.travelrequestwidget",
  "version": "2.0.0",
  "name": "Travel Request Widget",
  "description": "Editable enterprise transactional input widget for SAC",
  "vendor": "Arnav Choudhary",
  "newInstancePrefix": "TravelRequestWidget",
  "webcomponents": [
    {
      "kind": "main",
      "tag": "com-company-travelrequestwidget",
      "url": "https://sacplanning2025.github.io/hr_widget/travelRequestWidget.js",
      "integrity": "",
      "ignoreIntegrity": true
    }
  ],
  "properties": {
    "rows": { "type": "string", "default": "[]" },
    "lastEvent": { "type": "string", "default": "" },
    "validationResult": { "type": "string", "default": "true" },
    "validationErrors": { "type": "string", "default": "[]" },
    "savePayload": { "type": "string", "default": "[]" },
    "rowCount": { "type": "integer", "default": 0 },
    "selectedRowCount": { "type": "integer", "default": 0 },
    "widgetStatus": { "type": "string", "default": "READY" },

    "costCenterOptions": { "type": "string", "default": "[]" },
    "employeeOptions": { "type": "string", "default": "[]" },
    "positionOptions": { "type": "string", "default": "[]" },
    "routeOptions": { "type": "string", "default": "[]" },
    "initiativeOptions": { "type": "string", "default": "[]" },
    "purposeOptions": { "type": "string", "default": "[]" },
    "yesNoOptions": {
      "type": "string",
      "default": "[{\"key\":\"1\",\"text\":\"Yes\"},{\"key\":\"0\",\"text\":\"No\"}]"
    }
  },
  "methods": {
    "getRows": { "returnType": "string" },
    "setRows": { "parameters": [{ "name": "rowsJson", "type": "string" }] },

    "getRowCount": { "returnType": "integer" },
    "getSelectedRowCount": { "returnType": "integer" },
    "getRowValue": {
      "parameters": [
        { "name": "rowIndex", "type": "integer" },
        { "name": "fieldName", "type": "string" }
      ],
      "returnType": "string"
    },
    "getSelectedRowValue": {
      "parameters": [
        { "name": "selectedIndex", "type": "integer" },
        { "name": "fieldName", "type": "string" }
      ],
      "returnType": "string"
    },

    "addRow": {},
    "deleteSelectedRows": {},
    "clear": {},
    "validate": { "returnType": "string" },
    "getValidationErrors": { "returnType": "string" },
    "getValidationResult": { "returnType": "string" },

    "prepareSavePayload": { "returnType": "string" },
    "getSavePayload": { "returnType": "string" },

    "setCostCenterOptions": { "parameters": [{ "name": "json", "type": "string" }] },
    "setEmployeeOptions": { "parameters": [{ "name": "json", "type": "string" }] },
    "setPositionOptions": { "parameters": [{ "name": "json", "type": "string" }] },
    "setRouteOptions": { "parameters": [{ "name": "json", "type": "string" }] },
    "setInitiativeOptions": { "parameters": [{ "name": "json", "type": "string" }] },
    "setPurposeOptions": { "parameters": [{ "name": "json", "type": "string" }] },
    "setYesNoOptions": { "parameters": [{ "name": "json", "type": "string" }] },

    "getLastEvent": { "returnType": "string" }
  },
  "events": {
    "onFieldChange": {},
    "onDataChange": {},
    "onValidate": {},
    "onReady": {}
  }
}
