{
  "id": "com.company.assetentrywidget",
  "version": "1.0.2",
  "name": "Asset Entry Widget",
  "description": "Asset entry table widget for SAC",
  "vendor": "Arnav Choudhary",
  "newInstancePrefix": "AssetEntryWidget",
  "icon": "sap-icon://table-view",
  "webcomponents": [
    {
      "kind": "main",
      "tag": "com-company-assetentrywidget",
      "url": "https://sacplanning2025.github.io/hr_widget/assetwidget.js",
      "integrity": "",
      "ignoreIntegrity": true
    }
  ],
  "properties": {
    "rows": { "type": "string", "default": "[]" },
