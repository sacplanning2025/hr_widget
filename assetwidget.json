    "getLastEvent": { "returnType": "string" },
    "setCompanyOptions": {
      "parameters": [
        { "name": "json", "type": "string" }
      ]
    },
    "setCostCenterOptions": {
      "parameters": [
        { "name": "json", "type": "string" }
      ]
    },
    "setAssetClassOptions": {
      "parameters": [
        { "name": "json", "type": "string" }
      ]
    },
    "setCellValue": {
      "parameters": [
        { "name": "rowIndex", "type": "integer" },
        { "name": "fieldName", "type": "string" },
        { "name": "value", "type": "string" }
      ]
    },
    "setVisible": {
      "parameters": [
        { "name": "flag", "type": "boolean" }
      ]
    }
  },
  "events": {
    "onFieldChange": {},
    "onDataChange": {},
    "onValidate": {},
    "onReady": {}
  }
